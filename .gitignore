# Python / uv
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
*.log

# Frontend build / test output
frontend/coverage/

# Deploy-time version stamp (written by deploy.yml's deploy-functions job; never committed)
backend/app/build_version.txt

# Playwright
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/

# Secrets / local config
.env
local.settings.json
.secrets.json
e2e/.tmp/
e2e/.env.live

# OS / editor
.DS_Store

# Specs (local only, not published)
.specs/

docs/
# TypeScript incremental-build cache (tsc -b) — machine-generated
*.tsbuildinfo

# Functions deploy-package artifacts (CI vendors these on the runner; local
# vendoring for ad-hoc deploys must never be committed)
backend/.python_packages/
backend/requirements.txt
