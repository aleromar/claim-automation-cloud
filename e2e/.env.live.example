# Live e2e credentials (live-e2e spec) — cp to e2e/.env.live and fill in.
# NEVER commit the filled file (gitignored). Push the same values to GitHub
# Actions secrets with:  gh secret set -f e2e/.env.live

# Google Cloud console -> APIs & Services -> Credentials (the client the app uses)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The deployed app's Key Vault secret `gmail-refresh-token` (minted by a real login)
GMAIL_REFRESH_TOKEN=


GMAIL_ACCOUNT=

# https://trello.com/power-ups/admin (key) + its Token link (non-expiring token)
TRELLO_API_KEY=
TRELLO_TOKEN=

# The dedicated live-e2e test board: open the board, append .json to the URL —
# top-level `id` is the board id, `lists[0].id` is the list id.
TRELLO_BOARD_ID=
TRELLO_LIST_ID=
